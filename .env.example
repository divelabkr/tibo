# 공통
TIBO_IMAGE=ghcr.io/divelabkr/tibo:latest
HTTP_PORT=80
WATCHTOWER_POLL_INTERVAL=300

# 프로덕션 도메인
TIBO_DOMAIN=belo.team
CADDY_EMAIL=admin@belo.team

# Cloudflare Tunnel (docker-compose.tunnel.yml)
# Zero Trust → Networks → Tunnels → 토큰
# Public hostname: belo.team , www.belo.team → http://tibo:80
CLOUDFLARE_TUNNEL_TOKEN=
